# ====================================================
# KREZOEMA CMS — Environment Variables Template
# ====================================================
# Salin file ini menjadi .env.local untuk development lokal
# Untuk production Vercel, masukkan variabel berikut di:
# Vercel Dashboard → Project → Settings → Environment Variables
# ====================================================

# URL backend Laravel API (WAJIB diisi)
# Untuk production: https://absentik.site.je/api
# Untuk development lokal: http://127.0.0.1:8000/api
NEXT_PUBLIC_API_URL=https://absentik.site.je/api

# URL aplikasi CMS sendiri (untuk metadata SEO)
# Untuk production: https://cmskrezoema.vercel.app
# Untuk development lokal: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://cmskrezoema.vercel.app
